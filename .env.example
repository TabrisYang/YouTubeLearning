# ═══ 三個吃 key 的環節（系統自動偵測你填了哪些，採用對應模型）═══

# 🔍 搜尋影片｜必要
# https://console.cloud.google.com/apis/library/youtube.googleapis.com （啟用）
# https://console.cloud.google.com/apis/credentials （建金鑰）
YOUTUBE_API_KEY=

# 🎬 影片理解｜必要（Gemini 是目前唯一能合法「看完」YouTube 影片的管道）
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# 🧠 課綱編排｜建議填一家（不填則由 Gemini 兼任，免費層品質有妥協）
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# === LINE Messaging API ===
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# === GCP（空 = 本機 in-memory 模式，不需要 Firestore）===
GCP_PROJECT=

# === 使用者自備 key 的記憶體保管時效（小時）。系統不儲存任何使用者 key ===
BYOK_KEY_TTL_HOURS=24

# === 訂閱制（OAuth）入口僅對這些 LINE user id 顯示（逗號分隔）===
DEVELOPER_LINE_USER_IDS=

# === Feature flags（正式上線 ENABLE_OAUTH 必為 false）===
ENABLE_OAUTH=false
ENABLE_DAILY_PUSH=false

# === YouTube quota 預算 ===
YOUTUBE_DAILY_QUOTA=10000

# === 字幕抓取代理（部署雲端後若字幕大量失敗 = IP 被 YouTube 擋，填住宅代理 URL）===
# 格式：http://user:pass@proxy-host:port
TRANSCRIPT_PROXY_URL=

