# === 平台 LLM 憑證（points 模式至少填一家；預設模型是 Anthropic）===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# === YouTube Data API v3（平台預設；使用者也可在「設定」自備 key）===
YOUTUBE_API_KEY=

# === LINE Messaging API ===
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# === GCP（空 = 本機 in-memory 模式，不需要 Firestore）===
GCP_PROJECT=

# === 使用者自備 key 的記憶體保管時效（小時）。系統不儲存任何使用者 key ===
BYOK_KEY_TTL_HOURS=24

# === 訂閱制（OAuth）入口僅對這些 LINE user id 顯示（逗號分隔）===
DEVELOPER_LINE_USER_IDS=

# === Feature flags（正式上線 ENABLE_OAUTH 必為 false）===
ENABLE_OAUTH=false
ENABLE_DAILY_PUSH=false

# === YouTube quota 預算 ===
YOUTUBE_DAILY_QUOTA=10000

# === 字幕抓取代理（部署雲端後若字幕大量失敗 = IP 被 YouTube 擋，填住宅代理 URL）===
# 格式：http://user:pass@proxy-host:port
TRANSCRIPT_PROXY_URL=

